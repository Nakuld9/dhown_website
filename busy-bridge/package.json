{
  "name": "dhown-busy-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Integration middleware between DHOWN MES and BUSY accounting software.",
  "type": "commonjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.json && node dist/src/main.js",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
