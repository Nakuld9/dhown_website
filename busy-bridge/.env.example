# ---------------------------------------------------------------------------
# DHOWN BUSY BRIDGE — configuration
#
# SECURITY: this file is a TEMPLATE. Never commit a filled-in .env.
# BUSY credentials must never reach frontend code, and are never returned by
# any API route. The customer portal must not talk to this service at all.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4010
BIND_HOST=127.0.0.1

# SQLite file holding mappings, queue, audit and reconciliation state.
DATABASE_PATH=./data/busy-bridge.db

# --- Authentication ---------------------------------------------------------
# Shared secret the MES presents on internal API calls (X-Bridge-Key).
MES_API_KEY=change-me-mes-key

# Admin/dashboard key. Manual actions (retry, fix mapping, reconcile) require
# a key listed in BRIDGE_ADMIN_KEYS. Format: key:role,key:role
# Roles: viewer (read only) | operator (retry/reconcile) | admin (everything)
BRIDGE_ADMIN_KEYS=change-me-admin-key:admin

# --- BUSY adapter selection -------------------------------------------------
# Which BUSY transport to use. See docs/BUSY_INTEGRATION.md.
#   xml    - BUSY XML Data Export/Import over a watched file exchange (default)
#   rest   - third-party REST gateway, ONLY if the customer licensed one
#   memory - in-process fake, tests and local development only
BUSY_ADAPTER=xml

# --- XML file-exchange adapter ---------------------------------------------
# Shared-folder paths on the BUSY LAN. Fill in from the Section 6.3 checklist.
BUSY_XML_OUTBOX=./data/busy/outbox
BUSY_XML_ACK=./data/busy/ack
BUSY_XML_INBOX=./data/busy/inbox
BUSY_XML_ARCHIVE=./data/busy/archive
BUSY_COMPANY_NAME=DHOWN

# --- REST gateway adapter (only if BUSY_ADAPTER=rest) -----------------------
BUSY_REST_BASE_URL=
BUSY_REST_API_KEY=
BUSY_REST_TIMEOUT_MS=15000

# --- Queue / retry ----------------------------------------------------------
QUEUE_POLL_INTERVAL_MS=5000
QUEUE_BATCH_SIZE=10
# Attempts before a job is parked in MANUAL_REVIEW. Never retries forever.
MAX_ATTEMPTS=4
RETRY_BASE_DELAY_MS=30000
RETRY_MAX_DELAY_MS=3600000

# --- Which transactions flow MES -> BUSY (configurable per the spec) --------
# Comma-separated. Anything omitted is rejected at the internal API boundary.
ENABLED_ENTITY_TYPES=CUSTOMER,VENDOR,ITEM,SALES_REFERENCE,PURCHASE_REFERENCE,DISPATCH,INVOICE

# --- Reconciliation ---------------------------------------------------------
RECONCILE_INTERVAL_MS=900000
RECONCILE_LOOKBACK_DAYS=7
